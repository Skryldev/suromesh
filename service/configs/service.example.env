# SuroMesh Service configuration example (S1).
# Precedence: explicit defaults < environment variables (this file).
# Copy the lines you need; NEVER place secrets in committed files.
# Reserved keys (SUROMESH_CRYPTO_KEK, SUROMESH_STORAGE_POSTGRES_DSN)
# are rejected by validation until their implementation phases land.

# --- Listener (gRPC server arrives in S5; validated from S1) ---
# SUROMESH_LISTEN_ADDR=:50051
# SUROMESH_LISTEN_TLS_CERT=/etc/suromesh/tls/cert.pem
# SUROMESH_LISTEN_TLS_KEY=/etc/suromesh/tls/key.pem
# Development only: plaintext listener (incompatible with TLS pair)
# SUROMESH_LISTEN_PLAINTEXT_DEV=true

# --- Logging ---
# SUROMESH_LOG_LEVEL=info          # debug|info|warn|error
# SUROMESH_LOG_FORMAT=json         # json|text

# --- Accounts (runtime bounds; runners arrive in S5) ---
# SUROMESH_ACCOUNTS_AUTO_CONNECT=false
# SUROMESH_ACCOUNTS_MUTATION_QUEUE=64

# --- Update streams (S7) ---
# SUROMESH_STREAMS_BUFFER=1024

# --- Shutdown ---
# SUROMESH_SHUTDOWN_TIMEOUT=20s

# --- RESERVED (rejected in S1) ---
# SUROMESH_CRYPTO_KEK=...            # S4: envelope-encryption key source
# SUROMESH_STORAGE_POSTGRES_DSN=...  # S4: metadata + session storage
